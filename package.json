{
  "name": "glass-terminal",
  "productName": "Glass Terminal",
  "desktopName": "glass-terminal",
  "version": "0.2.0",
  "description": "Transparent desktop terminal with tabs and native PTY sessions",
  "author": "Glass Terminal contributors",
  "license": "MIT",
  "homepage": "https://github.com/isaacvoou/Glass-Terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/isaacvoou/Glass-Terminal.git"
  },
  "main": "app/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup.cjs",
    "start": "electron .",
    "icons": "node scripts/icons.cjs",
    "prepare:assets": "node scripts/copy-vendor.cjs && node scripts/icons.cjs",
    "test": "node --test tests/unit.test.cjs",
    "test:pty": "node scripts/run-pty-tests.cjs",
    "test:app": "electron tests/electron-smoke.cjs",
    "test:packaged": "node scripts/test-packaged.cjs",
    "pack": "npm run prepare:assets && electron-builder --dir --publish never",
    "dist:linux": "node scripts/dist.cjs linux",
    "dist:win": "node scripts/dist.cjs win",
    "dist:mac": "node scripts/dist.cjs mac"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@xterm/headless": "6.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "node-gyp": "12.2.0",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "dev.glassterminal.desktop",
    "productName": "Glass Terminal",
    "artifactName": "Glass-Terminal-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "app/**/*",
      "assets/icon.png",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "nativeRebuilder": "sequential",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build-resources/icon.icns",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glass Terminal",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true,
      "icon": "build-resources/icons",
      "category": "System",
      "synopsis": "Transparent terminal emulator",
      "maintainer": "Glass Terminal contributors <noreply@glassterminal.local>",
      "desktop": {
        "entry": {
          "StartupWMClass": "glass-terminal"
        }
      }
    }
  }
}
